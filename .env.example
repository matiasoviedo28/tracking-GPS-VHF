# --- Base de datos (Postgres) ---
POSTGRES_USER=bomberos_tracking
POSTGRES_PASSWORD=cambiar-esta-clave
POSTGRES_DB=bomberos_tracking
# Puerto expuesto en el host para conectarse a Postgres desde afuera del
# contenedor (ej. con un cliente SQL). No confundir con el puerto interno
# 5432 usado entre contenedores.
POSTGRES_PORT=5432

# --- Backend ---
# Puerto expuesto en el host para la API/WebSocket del backend.
# Debe coincidir con BACKEND_WS_PORT en frontend/app.js.
BACKEND_PORT=8000

# DATABASE_URL la requiere backend/app/database.py, pero docker-compose.yml
# ya la arma automáticamente a partir de POSTGRES_USER/PASSWORD/DB de arriba
# (ver el servicio "backend" en docker-compose.yml) — no hace falta definirla
# acá para levantar el proyecto con docker compose up. Descomentar y ajustar
# solo si corrés el backend suelto, fuera de docker-compose (ej. uvicorn local).
# DATABASE_URL=postgresql://bomberos_tracking:cambiar-esta-clave@localhost:5432/bomberos_tracking

# --- Frontend ---
# Puerto expuesto en el host para acceder al mapa desde el navegador.
FRONTEND_PORT=8080

# --- sdr-decoder (placeholder, no usado todavía) ---
# URL interna (red de docker-compose) donde sdr-decoder debe enviar la
# telemetría una vez implementado. No requiere puerto de host propio.
# BACKEND_INTERNAL_URL=http://backend:8000
