# --- Base de datos (Postgres) ---
POSTGRES_USER=bomberos_tracking
POSTGRES_PASSWORD=cambiar-esta-clave
POSTGRES_DB=bomberos_tracking
# Puerto expuesto en el host para conectarse a Postgres desde afuera del
# contenedor (ej. con un cliente SQL). No confundir con el puerto interno
# 5432 usado entre contenedores.
POSTGRES_PORT=5432

# --- Backend ---
# Puerto expuesto en el host para la API/WebSocket del backend.
# Debe coincidir con BACKEND_WS_PORT en frontend/app.js.
BACKEND_PORT=8000

# DATABASE_URL la requiere backend/app/database.py, pero docker-compose.yml
# ya la arma automáticamente a partir de POSTGRES_USER/PASSWORD/DB de arriba
# (ver el servicio "backend" en docker-compose.yml) — no hace falta definirla
# acá para levantar el proyecto con docker compose up. Descomentar y ajustar
# solo si corrés el backend suelto, fuera de docker-compose (ej. uvicorn local).
# DATABASE_URL=postgresql://bomberos_tracking:cambiar-esta-clave@localhost:5432/bomberos_tracking

# Segundos desde ultimo_visto para considerar un equipo "online" en
# GET /api/equipos (ver docs/API.md). Opcional — si no se define, el backend
# usa 300 (5 minutos) por defecto.
# PRESENCE_ONLINE_THRESHOLD_SECONDS=300

# Directorio donde backend guarda los archivos de la bitácora de audio (ver
# docs/API.md, POST /api/audio-eventos). Opcional — si no se define, usa
# "storage/audio" (relativo al WORKDIR /app del contenedor), que
# docker-compose.yml ya monta como el volumen nombrado "audio_data" para que
# sobreviva a un rebuild. Cambiar solo si se necesita otra ubicación.
# AUDIO_STORAGE_DIR=storage/audio

# --- Frontend ---
# Puerto expuesto en el host para acceder al mapa desde el navegador.
FRONTEND_PORT=8080

# --- sdr-decoder ---
# Todas opcionales — docker-compose.yml ya las pasa al contenedor con estos
# mismos defaults si no se definen acá. Ver docs/operacion-sdr.md para el
# procedimiento de recalibración manual de SDR_FREQ_CORR_HZ cuando haga falta.
# SDR_FRECUENCIA_HZ=159635000
# SDR_GANANCIA=30
# SDR_FREQ_CORR_HZ=-7600
# MALA_ANTENA_STD_UMBRAL=1.5
# VENTANA_SIN_DATOS_BLOQUES=10
